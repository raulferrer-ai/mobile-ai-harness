# harness.env - the single place to configure this harness.
# Format: KEY=VALUE (POSIX sh syntax, no spaces around "="). Quote values that contain spaces.
# Read by: Makefile (include), init.sh and scripts/*.sh (sourced), scripts/harness_config.py (parsed).
# Change values HERE instead of editing scripts.

# --- Project ---------------------------------------------------------------
PROJECT_NAME=my-mobile-app
# Platforms this product ships. A feature may target a subset (see feature_list.json).
PLATFORMS="ios android"

# --- iOS sensor ------------------------------------------------------------
IOS_DIR=ios
# Path to the .xcodeproj (a directory) and scheme. Adjust after creating the Xcode project.
IOS_PROJECT=ios/App/App.xcodeproj
IOS_SCHEME=App
# List valid names with: make simulators
IOS_DESTINATION="platform=iOS Simulator,name=iPhone 17 Pro"
# test  = xcodebuild test (default, counts as a full sensor)
# build = xcodebuild build only (DEGRADED: recorded as such in the gate)
IOS_SENSOR_MODE=test
# Destination used by CI build-only checks (no simulator name needed).
IOS_CI_DESTINATION="generic/platform=iOS Simulator"
# Optional lint command, run by "make lint-ios". Example: swift format lint --strict --recursive ios
IOS_LINT_CMD=

# --- Android sensor --------------------------------------------------------
ANDROID_DIR=android
ANDROID_TEST_TASK=:app:testDebugUnitTest
ANDROID_LINT_TASK=:app:lintDebug
# Minimum JDK major version required by your Android Gradle Plugin.
MIN_JDK=17

# --- Contract budgets (max lines) -----------------------------------------
# Keep always-loaded instructions lean; move detail to docs/ or .agents/references/.
BUDGET_ROOT_AGENTS=150
BUDGET_PLATFORM_AGENTS=130
BUDGET_POINTER=15
BUDGET_SKILL=80
