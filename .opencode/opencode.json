{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "android/AGENTS.md", "ios/AGENTS.md"],
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git clean -f*": "deny",
      "git commit*--no-verify*": "deny",
      "python3 scripts/feature.py done*": "deny",
      "sudo *": "deny"
    }
  }
}
